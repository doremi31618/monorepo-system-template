{
	"name": "@platform/oauth-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/oauth-server.schema.d.ts",
			"import": "./dist/oauth-server.schema.js",
			"default": "./dist/oauth-server.schema.js"
		}
	},
	"bin": {
		"oauth-admin": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.capability.config.cjs --runInBand --testPathPattern /packages/oauth-server/",
		"oauth-admin": "node ./dist/cli.js"
	},
	"dependencies": {
		"@nestjs/common": "^10.0.0",
		"@platform/auth": "workspace:*",
		"@platform/config": "workspace:*",
		"@platform/database": "workspace:*",
		"@platform/logger": "workspace:*",
		"@platform/users": "workspace:*",
		"drizzle-orm": "^0.44.7",
		"jose": "^6.2.10",
		"oidc-provider": "^9.11.4"
	},
	"devDependencies": {
		"@types/oidc-provider": "^9.11.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.0"
	}
}
