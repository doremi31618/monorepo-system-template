{
  "name": "@platform/nest-identity-auth",
  "version": "0.1.0",
  "description": "NestJS 的 Identity／Auth 登入、Session 與密碼重設能力",
  "private": true,
  "platform": { "runtime": "node", "framework": "nestjs", "layer": "feature", "domain": "identity" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/auth.schema.d.ts", "import": "./dist/auth.schema.js", "default": "./dist/auth.schema.js" }
  },
  "scripts": { "build": "tsc -p tsconfig.json" },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@platform/types-identity": "workspace:*",
    "@platform/nest-infra-database": "workspace:*",
    "@platform/nest-infra-logger": "workspace:*",
    "@platform/nest-infra-mail": "workspace:*",
    "@platform/nest-infra-scheduling": "workspace:*",
    "@platform/nest-identity-users": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.4",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^176.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@nestjs/testing": "^10.4.22",
    "express": "^4.22.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": { "reflect-metadata": "^0.2.0", "rxjs": "^7.8.0" }
}
