{
  "name": "@platform/nest-content-cms",
  "version": "0.1.0",
  "description": "NestJS 的 Content／CMS 文章、標籤與公開內容能力",
  "private": true,
  "platform": { "runtime": "node", "framework": "nestjs", "layer": "feature", "domain": "content" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/cms.schema.d.ts", "import": "./dist/cms.schema.js", "default": "./dist/cms.schema.js" }
  },
  "scripts": { "build": "tsc -p tsconfig.json" },
  "dependencies": {
    "@platform/types-content": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@platform/nest-content-assets": "workspace:*",
    "@platform/nest-identity-users": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": { "@types/express": "^4.17.17", "typescript": "^5.9.3" },
  "peerDependencies": { "reflect-metadata": "^0.2.0", "rxjs": "^7.8.0" }
}
