{
  "name": "@platform/nest-infra-mail",
  "version": "0.1.0",
  "description": "NestJS 的郵件寄送與 outbox 能力",
  "private": true,
  "platform": { "runtime": "node", "framework": "nestjs", "layer": "infra", "domain": "infra" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/mail.schema.d.ts", "import": "./dist/mail.schema.js", "default": "./dist/mail.schema.js" }
  },
  "scripts": { "build": "tsc -p tsconfig.json" },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@platform/nest-infra-database": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": { "@nestjs/testing": "^10.4.22", "@types/nodemailer": "^8.0.1", "typescript": "^5.9.3" },
  "peerDependencies": { "reflect-metadata": "^0.2.0", "rxjs": "^7.8.0" }
}
