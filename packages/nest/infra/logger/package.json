{
  "name": "@platform/nest-infra-logger",
  "version": "0.1.0",
  "description": "NestJS 的結構化日誌能力",
  "private": true,
  "platform": {
    "runtime": "node",
    "framework": "nestjs",
    "layer": "infra",
    "domain": "infra"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
