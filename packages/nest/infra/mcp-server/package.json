{
  "name": "@platform/nest-infra-mcp-server",
  "version": "0.1.0",
  "description": "NestJS 的 MCP HTTP transport 與 OAuth resource metadata adapter",
  "private": true,
  "platform": { "runtime": "node", "framework": "nestjs", "layer": "infra", "domain": "infra" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --experimental-vm-modules ../../../../node_modules/jest/bin/jest.js --config ../../../../jest.capability.config.cjs --runInBand --testPathPattern /packages/nest/infra/mcp-server/"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
