{
  "name": "@platform/svelte-service-ui",
  "version": "0.1.0",
  "description": "Svelte 的服務狀態與服務目錄展示元件",
  "private": true,
  "platform": { "runtime": "browser", "framework": "svelte", "layer": "ui", "domain": "shared" },
  "type": "module",
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "bun test tests"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
