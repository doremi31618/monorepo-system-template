NODE_ENV=dev
PORT=3333
API_BASE_URL=http://localhost:3333
HOST_URL=http://localhost:3333/v1
FRONTEND_URL=http://localhost:5173
WORKER_ID=local-api

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# The API owns the bootstrap administrator. Packages only receive this as injected config.
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_NAME=System Administrator
ROOT_ADMIN_PASSWORD=change-me-admin-password

# Mail settings
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# Optional Google OAuth credentials.
GOOGLE_SSO_CLIENT_ID=your-google-client-id
GOOGLE_SSO_CLIENT_SECRET=your-google-client-secret

# Object storage (MinIO locally; S3-compatible providers in deployed environments).
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=r3-assets
STORAGE_FORCE_PATH_STYLE=true
