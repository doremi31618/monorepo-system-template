NODE_ENV=dev
PORT=3333
API_PROTOCOL=http
API_HOST=localhost
API_BASE_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
JWT_SECRET=please-change-me
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
BCRYPT_SALT_ROUNDS=12

# OAuth 2.1 / OpenID Connect. Production requires a private ES256 JWKS.
OAUTH_ISSUER=http://localhost:3333
OAUTH_PRIVATE_JWKS=
OAUTH_DCR_ENABLED=true
OAUTH_DCR_RESOURCES=http://localhost:3333/mcp
OAUTH_DCR_SCOPES=openid,email,profile,offline_access,mcp:tools
OAUTH_DCR_RATE_LIMIT=10
OAUTH_DCR_RATE_WINDOW_SECONDS=3600
OAUTH_TOKEN_RATE_LIMIT=120
AUTH_LOGIN_RATE_LIMIT=10

# Mail settings
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
