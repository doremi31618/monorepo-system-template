# Required public Web configuration.
#
# Vite exposes every VITE_* variable to browser code. Never put passwords,
# database URLs, private API keys, or other secrets in this file.
#
# Include the API global prefix (`/v1`) and omit the trailing slash because
# the browser SDK appends endpoint paths such as `/auth/login`.
VITE_API_BASE_URL=http://localhost:3333/v1
